# Environment Configuration for YouTube Analyzer & Search Intelligence Platform

# Database Connection (Defaults to local SQLite)
DATABASE_URL="sqlite:///youtube_analyzer.db"

# HasData Google Trends API Key (Optional for development / mock fallback available)
HASDATA_API_KEY=""

# YouTube Data API Key (Optional for development / public suggest fallback available)
YOUTUBE_API_KEY=""

# Google Ads API Credentials (For Google Keyword Planner)
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""

# SQL Query Logging
SQL_ECHO="false"
