# Force LF line endings for all Python files (prevents ruff format issues on CI/Linux)
* text=auto eol=lf

# Explicitly set LF for Python files
*.py text eol=lf

# Keep Windows line endings for Windows-specific files
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.lock binary
